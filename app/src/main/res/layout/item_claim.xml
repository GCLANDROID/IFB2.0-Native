<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="3dp"
    card_view:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtProduct"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WM"
                android:textColor="#30243D"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="7dp"
                android:text="Model Missing"
                android:textColor="#965200"
                android:textSize="11sp"
                android:background="#FFF0D8"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txtClaimID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Claim ID: 92"
            android:textColor="#55505C"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Customer: Arpan Saha"
            android:textColor="#30243D"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Mobile: 9804043285"
            android:textColor="#30243D"
            android:textSize="14sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#EAE5ED"/>

        <TextView
            android:id="@+id/txtSaleDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sale Date: 20 Oct 2026"
            android:textColor="#514957"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtInvoiceValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Invoice Value: ₹31,644.01"
            android:textColor="#30243D"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:visibility="gone"
            android:id="@+id/txtDeliveryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Delivery Date: 23 Oct 2026"
            android:textColor="#514957"
            android:textSize="13sp"/>

        <TextView
            android:visibility="gone"
            android:id="@+id/txtDeliveryBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Delivery By: VTS_WebOrder"
            android:textColor="#514957"
            android:textSize="13sp"/>

        <LinearLayout
            android:id="@+id/modelSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp"
            android:padding="10dp"
            android:background="#F5F0F8">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected Model"
                android:textColor="#65586D"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txtSelectedModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No model selected"
                android:textColor="#30243D"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnChooseModel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Choose Model"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#76577F"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#248653"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>