<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginHorizontal="15dp"
    android:background="@drawable/bg_invoice_dialog">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:background="@drawable/bg_notification_icon"
            android:src="@drawable/ic_notifications"
            app:tint="#E80E0E"
            android:contentDescription="Notification"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Notification"
            android:textColor="#252525"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            app:tint="#777777"
            android:contentDescription="Close"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#EEEEEE"/>

    <!-- Title -->
    <TextView
        android:id="@+id/tvNotificationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        tools:text="Important Announcement"
        android:textColor="#252525"
        android:textSize="19sp"
        android:textStyle="bold"/>

    <!-- Message -->
    <TextView
        android:id="@+id/tvNotificationMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        tools:text="Please read the latest announcement carefully. This notification contains important information from your organization."
        android:textColor="#555555"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"/>

    <!-- OK Button -->
    <TextView
        android:id="@+id/btnNotificationOk"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="OK, Got it"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:background="@drawable/bg_notification_button"/>

</LinearLayout>
