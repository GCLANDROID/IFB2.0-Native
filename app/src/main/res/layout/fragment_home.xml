<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout

                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:background="@color/color9"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >
                    <androidx.cardview.widget.CardView
                        card_view:cardCornerRadius="10dp"
                        xmlns:card_view="http://schemas.android.com/apk/res-auto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        card_view:cardElevation="5dp"
                        card_view:cardUseCompatPadding="true"
                        android:layout_weight="1">
                        <LinearLayout
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_color"
                                android:textSize="12sp"
                                android:text="Present:"></TextView>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/green"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:id="@+id/tvPresent"></TextView>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        xmlns:card_view="http://schemas.android.com/apk/res-auto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        card_view:cardElevation="5dp"
                        card_view:cardUseCompatPadding="true"
                        android:layout_marginLeft="10dp"
                        card_view:cardCornerRadius="10dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:padding="20dp"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_color"
                                android:textSize="12sp"
                                android:text="Absent:"></TextView>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/red"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:id="@+id/tvAbsent"></TextView>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
                <org.naishadhparmar.zcustomcalendar.CustomCalendar
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/custom_calendar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_margin="10dp">


                </org.naishadhparmar.zcustomcalendar.CustomCalendar>
                <LinearLayout
                    android:layout_marginLeft="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical">

                        <!--View to display the yellow color icon-->
                        <View
                            android:layout_gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/green"/>

                        <!--Text view to display R -->
                        <TextView
                            android:textSize="12sp"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Present"
                            android:layout_marginLeft="5dp"/>

                    </LinearLayout>

                    <!--Linear layout to display Python-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp">

                        <!--View to display the green color icon-->
                        <View
                            android:layout_gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/red" />

                        <!--Text view to display python text -->
                        <TextView
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="5dp"
                            android:text="Absent" />

                    </LinearLayout>

                    <!--Linear layout to display C++-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp">

                        <!--View to display the red color icon-->
                        <View
                            android:layout_gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/color4"/>

                        <!--Text view to display C++ text -->
                        <TextView
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekly Off"
                            android:paddingLeft="5dp"/>

                    </LinearLayout>

                    <!--Linear layout to display Java-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp">

                        <!--View to display the blue color icon-->
                        <View
                            android:layout_gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/yellow"/>

                        <!--Text view to display Java text -->
                        <TextView
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Holiday"
                            android:paddingLeft="5dp"/>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp">

                        <!--View to display the blue color icon-->
                        <View
                            android:layout_gravity="center"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@color/cyan"/>

                        <!--Text view to display Java text -->
                        <TextView
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="On Leave"
                            android:paddingLeft="5dp"/>

                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="#FBF4C1"
                    android:padding="10dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/red"
                        android:textStyle="bold"
                        ></TextView>
                    <TextView
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/color10"
                        android:textStyle="bold"
                        android:id="@+id/tvInformation"></TextView>
                    <TextView
                        android:layout_marginTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/color10"
                        android:textStyle="bold"
                        android:id="@+id/tvInformation2"></TextView>


                </LinearLayout>
                <Button
                    android:id="@+id/btnDisplayMatrix"
                    android:background="@drawable/lldesign9"
                    android:backgroundTint="@color/red"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textColor="@color/white"
                    android:text="Update display matrix"
                    android:drawableRight="@drawable/rightarrow"
                    android:drawableTint="@color/white"
                    android:padding="5dp"></Button>
                <Button
                    android:id="@+id/btnPalnogram"
                    android:background="@drawable/lldesign9"
                    android:backgroundTint="@color/yellow"
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textColor="@color/black"
                    android:text="Update planogram Hygene"
                    android:drawableRight="@drawable/rightarrow"
                    android:drawableTint="@color/black"
                    android:padding="5dp"></Button>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center"
                    android:padding="10dp">

                    <androidx.cardview.widget.CardView
                        card_view:cardCornerRadius="5dp"
                        xmlns:card_view="http://schemas.android.com/apk/res-auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        card_view:cardUseCompatPadding="true"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">
                            <TextView
                                android:layout_gravity="right"
                                android:padding="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="@color/blue"
                                android:textStyle="bold"
                                android:text="Monthly Sales Information"></TextView>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <org.eazegraph.lib.charts.PieChart
                                    xmlns:app="http://schemas.android.com/apk/res-auto"
                                    android:id="@+id/piechart"
                                    android:layout_width="0dp"
                                    android:layout_height="200dp"
                                    android:padding="6dp"
                                    android:layout_weight="1"


                                    />
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:layout_marginLeft="20dp"
                                    android:orientation="vertical"
                                    android:gravity="center_vertical"
                                    >

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical">

                                        <!--View to display the yellow color icon-->
                                        <View
                                            android:layout_gravity="center"
                                            android:layout_width="15dp"
                                            android:layout_height="15dp"
                                            android:background="@color/color4"/>

                                        <!--Text view to display R -->
                                        <TextView
                                            android:textSize="12sp"
                                            android:id="@+id/tvTarget"
                                            android:layout_gravity="center"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Target"
                                            android:layout_marginLeft="5dp"/>

                                    </LinearLayout>

                                    <!--Linear layout to display Python-->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginTop="5dp">

                                        <!--View to display the green color icon-->
                                        <View
                                            android:layout_gravity="center"
                                            android:layout_width="15dp"
                                            android:layout_height="15dp"
                                            android:background="@color/greeen" />

                                        <!--Text view to display python text -->
                                        <TextView
                                            android:textSize="12sp"
                                            android:id="@+id/tvSold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:paddingLeft="5dp"
                                            android:text="Sold" />

                                    </LinearLayout>

                                    <!--Linear layout to display C++-->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginTop="5dp">

                                        <!--View to display the red color icon-->
                                        <View
                                            android:layout_width="15dp"
                                            android:layout_height="15dp"
                                            android:background="@color/cyan"/>

                                        <!--Text view to display C++ text -->
                                        <TextView
                                            android:textSize="12sp"
                                            android:id="@+id/tvApprved"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Approved"
                                            android:paddingLeft="5dp"/>

                                    </LinearLayout>

                                    <!--Linear layout to display Java-->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginTop="5dp">

                                        <!--View to display the blue color icon-->
                                        <View
                                            android:layout_width="15dp"
                                            android:layout_height="match_parent"
                                            android:background="@color/yellow"/>

                                        <!--Text view to display Java text -->
                                        <TextView
                                            android:textSize="12sp"
                                            android:id="@+id/tvPending"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Pending"
                                            android:paddingLeft="5dp"/>

                                    </LinearLayout>
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_vertical"
                                        android:layout_marginTop="5dp">

                                        <!--View to display the blue color icon-->
                                        <View
                                            android:layout_width="15dp"
                                            android:layout_height="match_parent"
                                            android:background="@color/red"/>

                                        <!--Text view to display Java text -->
                                        <TextView
                                            android:text="Rejected"
                                            android:textSize="12sp"
                                            android:id="@+id/tvRejected"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:paddingLeft="5dp"/>

                                    </LinearLayout>

                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                </LinearLayout>


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>




</layout>