                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    &lt;!&ndash; Serial Number &ndash;&gt;
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
