<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".activity.AttendanceManageActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/color3"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_arrow_back_black_24dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center">

            <TextView
                android:background="@color/white"
                android:id="@+id/tvHelpDesk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:text="FAQ"
                android:padding="5dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:textColor="@android:color/black"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgHome"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:layout_marginLeft="10dp"
                android:src="@drawable/ic_home" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llLoader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/lldesign6"
            android:gravity="center"
            android:orientation="vertical">

            <pl.droidsonroids.gif.GifTextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/gifloader1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <fragment

            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="center"

            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5b9df2">

            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="--"
                android:textAppearance="?android:textAppearanceSmall"
                android:textColor="@color/color4" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llStatus"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/lldesign1"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAllCaps="true"
                    android:textAppearance="?android:textAppearanceMedium"
                    android:textColor="@color/color4"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:visibility="gone"
            android:id="@+id/llRegularize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/lldesign"
            android:layout_margin="10dp"
            android:backgroundTint="@color/orange_two"
            android:padding="10dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvText"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"
                 android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"></TextView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="right">
                <Button
                    android:id="@+id/btnRegularize"
                    android:textColor="@color/white"
                    android:text="Forgot to Mark Checkout"
                    android:textSize="12sp"
                    android:background="@color/orange"
                    android:layout_width="140dp"
                    android:padding="5dp"
                    android:layout_height="40dp"></Button>
                <Button
                    android:visibility="gone"
                    android:id="@+id/btnAbsent"
                    android:textColor="@color/white"
                    android:text="Accept &amp; Continue"
                    android:textSize="12sp"
                    android:background="@color/orange"
                    android:layout_width="140dp"
                    android:padding="5dp"
                    android:layout_height="40dp"></Button>
            </LinearLayout>


        </LinearLayout>
        <LinearLayout

            android:id="@+id/llChekcinout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/lldesign"
            android:layout_margin="10dp"
            android:backgroundTint="@color/background_color"
            android:padding="10dp"
            android:orientation="vertical">
            <TextView
                android:textSize="10sp"
                android:layout_marginBottom="10dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your stipulated shift duration is calculated as per the applicable working hours policy. Please ensure adherence to the defined shift timings in line with organisational guidelines"></TextView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/clockicon"
                            app:tint="@color/black"></ImageView>
                        <TextView
                            android:layout_marginLeft="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:id="@+id/tvCheckIN"></TextView>
                    </LinearLayout>
                    <TextView
                        android:layout_marginLeft="25dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/android_text_color"
                        android:layout_marginTop="5dp"
                        android:textSize="14sp"
                        android:text="Check In"></TextView>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.5"
                    android:gravity="center">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"></View>
                </LinearLayout>
                <LinearLayout
                    android:gravity="right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/wallclock"></ImageView>
                        <TextView
                            android:layout_marginLeft="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:id="@+id/tvCheckOut"></TextView>
                    </LinearLayout>
                    <TextView
                        android:layout_marginLeft="25dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/android_text_color"
                        android:layout_marginTop="5dp"
                        android:textSize="14sp"
                        android:text="Shift Over Time"></TextView>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/lnCamera"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:text="Upload Your Image"
                            android:textColor="@color/text_color"
                            android:textSize="14sp"></TextView>

                        <ImageView
                            android:id="@+id/imgCamera"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_camera"></ImageView>

                        <ImageView
                            android:id="@+id/imgImage"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginLeft="10dp"></ImageView>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llPunch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="50dp"
                        android:gravity="center"
                        android:visibility="visible"
                        android:orientation="horizontal">

                        <LinearLayout

                            android:layout_width="190dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/lldesign"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:backgroundTint="@color/green">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/pointericon"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_marginLeft="5dp"
                                android:id="@+id/tvMark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Check In"
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textColor="@android:color/white"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                    <LinearLayout

                        android:id="@+id/llPunchOut"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"
                        android:visibility="gone"
                        >

                        <LinearLayout
                            android:padding="12dp"
                            android:layout_width="190dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/lldesign"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:backgroundTint="@color/primary_dark">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/pointericon"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_gravity="center"
                                android:layout_marginLeft="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Check Out"
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textColor="@android:color/white"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginTop="20dp"
                        android:id="@+id/llBreak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:gravity="center"
                        android:visibility="gone"
                        >

                        <LinearLayout
                            android:padding="12dp"
                            android:layout_width="190dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/lldesign"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:backgroundTint="@color/orange_one">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:src="@drawable/lunchbreak"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/tvBreakText"
                                android:layout_gravity="center"
                                android:layout_marginLeft="10dp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Break Start"
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textColor="@android:color/white"
                                android:textStyle="bold" />
                        </LinearLayout>


                    </LinearLayout>




                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/llReport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:src="@drawable/attendancereporticon" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/llBlocker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6C000000"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <LinearLayout
                android:layout_marginHorizontal="30dp"
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:background="@drawable/lldesign"
                android:backgroundTint="@color/white"
                android:padding="10dp"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/lldesign">
                        <ImageView
                            android:scaleType="fitXY"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:src="@mipmap/anc"></ImageView>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_margin="10dp"
                        android:layout_gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="right">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:id="@+id/tvHeaderBlocker"></TextView>
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:id="@+id/tvBlcckerText"></TextView>

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2"
            android:gravity="top|center">
            <Button
                android:background="@drawable/lldesign"
                android:backgroundTint="@color/saffron_kesari"
                android:id="@+id/btnBlockerOK"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:text="OK"></Button>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>